meta {
  name: Edit Article
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/blog/articles/1/edit/
  body: form-urlencoded
  auth: none
}

body:form-urlencoded {
  title: 更新後的標題
  content: 更新後的內容
  author: 1
  tags: 1
  is_published: true
}

headers {
  Content-Type: application/x-www-form-urlencoded
  Accept: text/html
}

docs {
  # 編輯文章
  
  將 URL 中的 `1` 替換為實際的文章 ID
  注意：此端點需要 CSRF token，可能需要先登入
}

