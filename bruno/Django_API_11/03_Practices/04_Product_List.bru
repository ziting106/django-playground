meta {
  name: Product List
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/practices/products/
  body: none
  auth: none
}

params:query {
  category: all
  sort: newest
  page: 1
}

headers {
  Accept: text/html
}

docs {
  # 產品列表
  
  查詢參數：
  - category: 產品分類 (預設: all)
  - sort: 排序方式 (預設: newest)
  - page: 頁碼 (預設: 1)
}

