meta {
  name: User Articles
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/practices/users/john/articles/
  body: none
  auth: none
}

params:query {
  sort: newest
  page: 1
}

headers {
  Accept: text/html
}

docs {
  # 使用者文章列表
  
  URL 參數：
  - username: 使用者名稱 (字串)
  
  查詢參數：
  - sort: 排序方式 (預設: newest)
  - page: 頁碼 (預設: 1)
}

