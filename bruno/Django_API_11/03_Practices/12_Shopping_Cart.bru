meta {
  name: Shopping Cart
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/practices/cart/
  body: none
  auth: none
}

params:query {
  action: add
  product: product1
}

headers {
  Accept: text/html
  Cookie: sessionid=your_session_id_here
}

docs {
  # 購物車功能
  
  查詢參數：
  - action: 操作類型 (add, remove, clear)
  - product: 產品名稱 (當 action 為 add 或 remove 時需要)
  
  注意：此端點使用 Session，需要設定 Cookie 中的 sessionid
}

