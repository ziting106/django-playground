meta {
  name: Password Reset
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/password-reset/
  body: form-urlencoded
  auth: none
}

body:form-urlencoded {
  email: user@example.com
  csrfmiddlewaretoken: 
}

headers {
  Content-Type: application/x-www-form-urlencoded
  Accept: text/html
  Referer: {{baseUrl}}/auth/password-reset/
}

docs {
  # 重設密碼請求
  
  注意：
  1. 需要先取得 CSRF token
  2. 會發送重設密碼郵件到指定 email
  3. 郵件會包含重設連結和 token
}

